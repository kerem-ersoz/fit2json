# Secrets — never commit this file
GITHUB_TOKEN=ghp_your_token_here
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_password
# GARMINTOKENS is NOT a secret — it's the directory where the Garmin session token
# cache is stored (default ~/.garminconnect). Leave it unset here; the automatic-export
# wrapper sets it to a mounted path. See "Automatic / continuous export" in the README.
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REFRESH_TOKEN=your_refresh_token
