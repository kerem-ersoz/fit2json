# Secrets — never commit this file

# Required for `fetch garmin`
GARMIN_EMAIL=your@email.com
GARMIN_PASSWORD=your_password
# GARMINTOKENS is NOT a secret — it's the directory where the Garmin session token
# cache is stored (default ~/.garminconnect). Point it at a persistent/mounted path when
# running `fetch garmin --watch` (e.g. a Docker volume). See "Continuous export (watch
# mode)" in the README.

# Required for `fetch strava`
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
STRAVA_REFRESH_TOKEN=your_refresh_token

# `analyze` needs no key for the Copilot CLI or local LLMs (Ollama / LM Studio).
# Only set this if you point --base-url at an OpenAI-compatible endpoint that needs auth:
# OPENAI_API_KEY=sk-your_key_here

# ── FitSift web UI in Docker (docker compose / scripts/fitsift) ────────────────
# These are read by docker compose (host side), all optional:
# FIT2JSON_HOME=/absolute/path/to/.fit2json   # data dir mounted at /data (default ~/.fit2json)
# FITSIFT_PORT=8000                            # host port for the web UI
# FITSIFT_BIND_HOST=127.0.0.1                  # keep Docker private when using Tailscale Serve
# FITSIFT_CORS_ORIGINS=https://www.example.com
# POLL_INTERVAL=900                            # seconds between Garmin polls (poller service)
# WATCH_INTERVAL=3600                          # seconds between image-update checks (autoupdate)
# Host auto-analyzer (scripts/fitsift all|analyzer):
# ANALYZE_BACKEND=copilot                      # copilot | ollama | lmstudio
# ANALYZE_MODEL=claude-opus-4.8                # optional model (backend-specific)
# ANALYZE_EFFORT=high                          # optional copilot reasoning effort (needs ANALYZE_MODEL)
# ANALYZE_INTERVAL=900                         # seconds between analyzer polls
# ANALYZE_PROMPT=Coach me on this workout.     # prompt used for each auto-analysis
