<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd agent template for the near-real-time Garmin export.

  This is a TEMPLATE: the placeholders __WRAPPER__, __LOGDIR__ and __INTERVAL__
  are filled in by scripts/install-launchd.sh, which writes the result to
  ~/Library/LaunchAgents/com.fit2json.garmin-export.plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fit2json.garmin-export</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__WRAPPER__</string>
    </array>

    <!-- Poll interval in seconds (900 = 15 min). Change via INTERVAL when installing. -->
    <key>StartInterval</key>
    <integer>__INTERVAL__</integer>

    <!-- Run once shortly after the agent is loaded (e.g. login / install). -->
    <key>RunAtLoad</key>
    <true/>

    <!--
      launchd starts jobs with a minimal PATH that usually lacks `docker`.
      Include the common Docker Desktop / Homebrew locations so it resolves.
    -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/launchd.err.log</string>
</dict>
</plist>
